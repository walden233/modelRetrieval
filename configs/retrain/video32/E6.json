{
  "experiment_name": "E6",
  "output_dir": "artifacts/runs/retrain",
  "dataset": {
    "type": "rh20t",
    "root_dir": "dataset/RH20T_subset/RH20T_cfg2",
    "num_frames": 16,
    "sampling_strategy": "uniform",
    "max_pairs_per_scene": 2,
    "pair_manifests": {
      "RH20T_cfg2": "artifacts/manifests/retrain/v32/cfg2/metadata.json",
      "RH20T_cfg3": "artifacts/manifests/retrain/v32/cfg3/metadata.json"
    },
    "seed": 44,
    "intra_train_augmentations": {
      "brightness_jitter": 0.05,
      "noise_std": 0.01,
      "temporal_roll_max": 1
    }
  },
  "split": {
    "unit": "task",
    "seed": 44,
    "scene_counts": {
      "test": 120,
      "val": 50
    },
    "require_disjoint": true
  },
  "model": {
    "backbone_type": "vjepa",
    "backbone_name": "facebook/vjepa2-vitl-fpc64-256",
    "encoder_mode": "dual_head",
    "feature_dim": 128,
    "dropout": 0.1,
    "temperature": 0.07,
    "freeze_backbone": false,
    "unfreeze_last_n_blocks": 2,
    "backbone_dir": "artifacts/models/video/facebook--vjepa2-vitl-fpc64-256"
  },
  "loss": {
    "name": "multi_positive",
    "positive_level": "task",
    "lambda_intra": 0.2,
    "temperature": 0.07
  },
  "optimization": {
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "scheduler": "linear",
    "warmup_ratio": 0.05,
    "grad_clip_norm": 1.0
  },
  "training": {
    "batch_size": 16,
    "eval_batch_size": 16,
    "num_epochs": 7,
    "num_workers": 0,
    "amp": true,
    "gradient_accumulation_steps": 1,
    "sampler": "random"
  },
  "protocol": "retrain_v2",
  "seed": 44,
  "eval_manifests": {
    "cfg2": "artifacts/manifests/retrain/v32/cfg2/split_manifest_video.json",
    "cfg3": "artifacts/manifests/retrain/v32/cfg3/split_manifest_video.json"
  },
  "checkpoint_selection": {
    "loss_weight": 0.0,
    "mrr_weight": 1.0,
    "ndcg_weight": 0.0
  },
  "device": "cuda"
}
