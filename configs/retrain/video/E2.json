{
  "experiment_name": "E2",
  "output_dir": "artifacts/runs/retrain",
  "seed": 42,
  "dataset": {
    "type": "rh20t",
    "root_dir": "dataset/RH20T_subset/RH20T_cfg2",
    "num_frames": 16,
    "sampling_strategy": "uniform",
    "max_pairs_per_scene": 2,
    "pair_manifests": {
      "RH20T_cfg2": "artifacts/manifests/rh20t_shared_v1/cfg2_split_manifest.json",
      "RH20T_cfg3": "artifacts/manifests/rh20t_shared_v1/cfg3_split_manifest.json"
    },
    "seed": 42
  },
  "split": {
    "shared_manifest_path": "artifacts/manifests/rh20t_shared_v1/cfg2_split_manifest.json",
    "unit": "scene",
    "use_fixed_val": true,
    "val_count": 50
  },
  "model": {
    "backbone_type": "videomae",
    "backbone_name": "MCG-NJU/videomae-base",
    "encoder_mode": "dual_head",
    "feature_dim": 128,
    "dropout": 0.1,
    "temperature": 0.07,
    "freeze_backbone": true,
    "unfreeze_last_n_blocks": 0
  },
  "loss": {
    "name": "multi_positive",
    "positive_level": "task",
    "lambda_intra": 0.0,
    "temperature": 0.07
  },
  "optimization": {
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "scheduler": "linear",
    "warmup_ratio": 0.05,
    "grad_clip_norm": 1.0
  },
  "training": {
    "batch_size": 4,
    "eval_batch_size": 4,
    "num_epochs": 5,
    "num_workers": 0,
    "amp": true,
    "gradient_accumulation_steps": 1
  },
  "protocol": "retrain_v2",
  "eval_manifests": {
    "cfg2": "artifacts/manifests/rh20t_shared_v1/cfg2_split_manifest.json",
    "cfg3": "artifacts/manifests/rh20t_shared_v1/cfg3_split_manifest.json"
  },
  "checkpoint_selection": {
    "loss_weight": 0.0,
    "mrr_weight": 1.0,
    "ndcg_weight": 0.0
  },
  "device": "cuda"
}
