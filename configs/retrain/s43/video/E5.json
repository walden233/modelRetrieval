{
  "experiment_name": "E5",
  "output_dir": "artifacts/runs/retrain",
  "seed": 42,
  "dataset": {
    "type": "rh20t",
    "root_dir": "dataset/RH20T_subset/RH20T_cfg2",
    "num_frames": 16,
    "sampling_strategy": "uniform",
    "max_pairs_per_scene": 2,
    "pair_manifests": {
      "RH20T_cfg2": "artifacts/manifests/retrain/s43/cfg2/metadata.json",
      "RH20T_cfg3": "artifacts/manifests/retrain/s43/cfg3/metadata.json"
    },
    "seed": 42,
    "intra_train_augmentations": {
      "brightness_jitter": 0.05,
      "noise_std": 0.01,
      "temporal_roll_max": 1
    }
  },
  "split": {
    "shared_manifest_path": "artifacts/manifests/retrain/s43/cfg2/split_manifest_video.json",
    "unit": "scene",
    "use_fixed_val": true,
    "val_count": 50
  },
  "model": {
    "backbone_type": "vjepa",
    "backbone_name": "facebook/vjepa2-vitl-fpc64-256",
    "encoder_mode": "dual_head",
    "feature_dim": 128,
    "dropout": 0.1,
    "temperature": 0.07,
    "freeze_backbone": false,
    "unfreeze_last_n_blocks": 1
  },
  "loss": {
    "name": "multi_positive",
    "positive_level": "task",
    "lambda_intra": 0.2,
    "temperature": 0.07
  },
  "optimization": {
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "scheduler": "linear",
    "warmup_ratio": 0.05,
    "grad_clip_norm": 1.0
  },
  "training": {
    "batch_size": 4,
    "eval_batch_size": 4,
    "num_epochs": 5,
    "num_workers": 0,
    "amp": true,
    "gradient_accumulation_steps": 1
  },
  "protocol": "retrain_v2",
  "eval_manifests": {
    "cfg2": "artifacts/manifests/retrain/s43/cfg2/split_manifest_video.json",
    "cfg3": "artifacts/manifests/retrain/s43/cfg3/split_manifest_video.json"
  },
  "checkpoint_selection": {
    "loss_weight": 0.0,
    "mrr_weight": 1.0,
    "ndcg_weight": 0.0
  },
  "device": "cuda"
}
